# ─────────────────────────────────────────────────────────────
# EnglishMind AI · variables de entorno (plantilla)
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se commitea (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# Supabase — seguro de exponer en el cliente
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — NUNCA en el cliente ni en el bundle
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Claves de modelos de IA: NO van aquí en producción.
# Se guardan en los secrets/Vault del servidor (Edge Functions):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Para desarrollo local de la función puedes usar supabase/functions/.env
# ─────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
